rule agg_results_indirect:
    input:
        [f"results_celltype_B_model{m}/{row.effect_size}_sample{row.samp_n}"
        f"_cell{row.cell_count}_rep{row.rep}_rand{row.rand_seed}_cellB/qtl_stats.txt"
        for m in MODELS
        for row in setup.itertuples()]
    output:
        "summary_results_cellB.tsv"
    resources:
        mem_mb = 3000
    log:
        "logs/agg_results/agg_results.log"
    script:
        "scripts/agg_indirect_results.py"


